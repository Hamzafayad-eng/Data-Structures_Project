{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Streetlight Repair Desk",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/streetlight_app",
      "windows": {
        "program": "${workspaceFolder}/Source_Code/main.exe"
      },
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "build",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
